{
  //函数定义：name为函数名称，后面为返回值，因为前端接收到的是对象，后端接收到的是数组，数组不需要写键值对
  "function":{
    "inputFiles":{
        "name":"inputFiles"
        //其他返回值字段
    },
    "toggleMyLike":{
        "name":"toggleMyLike"
    }
  },
  "event":{
    "fullError":"fullError",//发生了完全的错误，需要全部回滚
    "partError":"partError",//发生了部分错误，比如导入5000个文件有3个文件发生错误
    "fullSuccess":"fullSuccess"//事件完全通过，并且需要弹窗报告成功
  }
}