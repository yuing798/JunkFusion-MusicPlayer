{
  //函数定义：键名为函数名称，后面为返回值，因为前端接收到的是对象，后端接收到的是数组，数组不需要写键值对
  //node UI/generateBridge.cjs执行

  //注意这里面写的字符串是为了跨端传输的，不要什么字符串都往里面写！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！

  "inputFiles":{
      //其他返回值字段
  },
  "toggleMyLike":{
  },
  "getAllSongCount":{
      //数据库里总共有多少首歌曲
      "count":"count"//返回歌曲总数
  },
  "refreshAllMusicSongs":{

      //参数
      "page":"page",
      "isAscending":"isAscending",
      "sortMode":"sortMode",

      //返回值
      "songsList":"songsList",

      "error":"error"//刷新失败，不要弹窗，改为一个图片放在页面上
  },
  "event":{//这些事件都需要弹窗警告
    "fullError":"fullError",//发生了完全的错误，需要全部回滚，通常为短小快速且涉及用户交互的事件
    "partError":"partError",//发生了部分错误，比如导入5000个文件有3个文件发生错误
    "fullSuccess":"fullSuccess"//事件完全通过，并且需要弹窗报告成功
  },
  "other":{
    "traditionalPageRows":20,//传统分页每一页的页数
    "scrollPageRows":50//滚动分页每一页的页数
  },

  "songInfo":{
    "id":"id",
    "duration":"duration",
    "title":"title",
    "artist":"artist",
    "album":"album",
    "albumArtist":"albumArtist",
    "genre":"genre",
    "trackNum":"trackNum",
    "discNum":"discNum",
    "year":"year",
    "composer":"composer",
    "multiStream":"multiStream",
    "bitRate":"bitRate",
    "sr":"sr",
    "numCh":"numCh",
    "bitDepth":"bitDepth",
    "codecName":"codecName",
    "isMusic":"isMusic",
    "aiGenre":"aiGenre",
    "bpm":"bpm",
    "key":"key",
    "aiProcessed":"aiProcessed",
    "isMyLike":"isMyLike",
    "comment":"comment",
    "playNum":"playNum"
  }
}//node UI/generateBridge.cjs执行